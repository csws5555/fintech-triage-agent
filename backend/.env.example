OLLAMA_BASE_URL=http://127.0.0.1:11434

OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

CHROMA_COLLECTION_NAME=fintech_policies_v1
CHROMA_DISTANCE_METRIC=cosine

RAG_CANDIDATE_K=8
RAG_MAX_CONTEXT_CHUNKS=4
RAG_MIN_RELEVANCE_SCORE=0.35

RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100

EMBEDDING_DOCUMENT_PREFIX=search_document:
EMBEDDING_QUERY_PREFIX=search_query:

CLASSIFIER_CONFIDENCE_THRESHOLD=0.70
CLASSIFIER_MARGIN_THRESHOLD=0.15
CLASSIFIER_MAX_LENGTH=128
ROUTING_SECONDARY_MIN_CONFIDENCE=0.20

OLLAMA_TEMPERATURE=0.0
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MAX_OUTPUT_TOKENS=300
OLLAMA_REQUEST_TIMEOUT_SECONDS=60

MAX_CUSTOMER_MESSAGE_LENGTH=2000
MAX_RESPONSE_CHARACTERS=2000